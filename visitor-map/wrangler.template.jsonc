{
  // This filename is intentionally not one Wrangler auto-discovers.
  // Deployment remains locked until the documented manual setup is complete.
  "name": "REPLACE_WITH_WORKER_NAME",
  "main": "src/index.mjs",
  "compatibility_date": "2026-08-30",
  "account_id": "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false,
      "invocation_logs": false,
      "head_sampling_rate": 0
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "REPLACE_WITH_D1_DATABASE_NAME",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["17 7 * * *"]
  }
}
